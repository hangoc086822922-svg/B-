-- LOGIC HITBOX NGHIÊM NGẶT (STRICT HITBOX)
---------------------------------------------------------

-- Hàm áp dụng Hitbox tức thì và chính xác
local function applyHitbox(player)
    if player ~= LocalPlayer and player.Character then
        local hrp = player.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            if Settings.HitboxEnabled then
                hrp.Size = Vector3.new(Settings.HitboxSize, Settings.HitboxSize, Settings.HitboxSize)
                hrp.Transparency = 0.7
                hrp.BrickColor = BrickColor.new("Really red")
                hrp.Material = Enum.Material.Neon
                hrp.CanCollide = false
            else
                hrp.Size = Vector3.new(2, 2, 1)
                hrp.Transparency = 1
            end
        end
    end
end

-- Vòng lặp cập nhật liên tục mỗi khung hình (RenderStepped)
RunService.RenderStepped:Connect(function()
    for _, player in pairs(Players:GetPlayers()) do
        applyHitbox(player)
    end
end)

---------------------------------------------------------
-- LOGIC ESP
---------------------------------------------------------
local EspDrawings = {}

local function createEspForPlayer(player)
    local drawing = {
        Line = Drawing.new("Line"),
        Box = Drawing.new("Square"),
        Text = Drawing.new("Text")
    }

    drawing.Line.Color = Color3.fromRGB(255, 255, 255)
    drawing.Line.Thickness = 1.5

    drawing.Box.Color = Color3.fromRGB(255, 0, 0)
    drawing.Box.Thickness = 1.5
    drawing.Box.Filled = false

    drawing.Text.Color = Color3.fromRGB(255, 255, 255)
    drawing.Text.Size = 14
    drawing.Text.Center = true
    drawing.Text.Outline = true

    EspDrawings[player] = drawing
end

local function removeEsp(player)
    if EspDrawings[player] then
        EspDrawings[player].Line:Remove()
        EspDrawings[player].Box:Remove()
        EspDrawings[player].Text:Remove()
        EspDrawings[player] = nil
    end
end

Players.PlayerAdded:Connect(createEspForPlayer)
Players.PlayerRemoving:Connect(removeEsp)

for _, p in pairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then createEspForPlayer(p) end
end

RunService.RenderStepped:Connect(function()
    for player, drawing in pairs(EspDrawings) do
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            local hrp = player.Character.HumanoidRootPart
            local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)

            if onScreen then
                if Settings.NameEsp then
                    local dist = math.floor((LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and (LocalPlayer.Character.HumanoidRootPart.Position - hrp.Position).Magnitude) or 0)
                    drawing.Text.Text = player.Name .. " [" .. tostring(dist) .. "m]"
                    drawing.Text.Position = Vector2.new(pos.X, pos.Y - 40)
                    drawing.Text.Visible = true
                else
                    drawing.Text.Visible = false
                end

                if Settings.LineEsp then
                    drawing.Line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    drawing.Line.To = Vector2.new(pos.X, pos.Y)
                    drawing.Line.Visible = true
                else
                    drawing.Line.Visible = false
                end

                if Settings.BoxEsp then
                    local sizeY = (Camera:WorldToViewportPoint(hrp.Position + Vector3.new(0, 3, 0)).Y - Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3.5, 0)).Y)
                    local sizeX = sizeY / 1.5
                    drawing.Box.Size = Vector2.new(math.abs(sizeX), math.abs(sizeY))
                    drawing.Box.Position = Vector2.new(pos.X - math.abs(sizeX) / 2, pos.Y - math.abs(sizeY) / 2)
                    drawing.Box.Visible = true
                else
                    drawing.Box.Visible = false
                end
            else
                drawing.Text.Visible = false
                drawing.Line.Visible = false
                drawing.Box.Visible = false
            end
        else
            drawing.Text.Visible = false
            drawing.Line.Visible = false
            drawing.Box.Visible = false
        end
    end
end)
